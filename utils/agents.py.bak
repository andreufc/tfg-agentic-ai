"""
BACKUP — manual-generate version of agents.py (pre-pipeline-simplification).

Kept as a restore point for the chat_template=True path: this version drives
``model.generate`` by hand (apply_chat_template -> generate -> decode) instead
of delegating to the HF text-generation pipeline. Restore this file over
``agents.py`` if the pipeline-messages path regresses on the T4.

agents.py — LangChain / LangGraph agent construction helpers.

Provides factory functions to build the Society-of-Minds agents
and collaboration graphs used in the thesis experiments.
"""

from __future__ import annotations

import random
from typing import Any, Optional

import torch
from langchain_core.runnables import Runnable, RunnableLambda  # type: ignore
from langchain_huggingface import HuggingFacePipeline  # type: ignore
from transformers import pipeline as hf_pipeline  # type: ignore


def _seed_all(seed: int) -> None:
    """Seed every relevant RNG source for fully reproducible generation.

    Sets the seed on Python's ``random`` module, NumPy (if available),
    PyTorch (CPU and all CUDA devices), and the HuggingFace/CUDA
    deterministic-algorithm flag so that the complete sequence of
    stochastic generation calls within a run is deterministic.

    Parameters
    ----------
    seed : int
        The integer seed value to apply everywhere.
    """
    random.seed(seed)
    try:
        import numpy as np  # type: ignore
        np.random.seed(seed)
    except ImportError:
        pass
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def build_hf_langchain_llm(
    model: Any,
    tokenizer: Any,
    max_new_tokens: int = 512,
    temperature: float = 0.7,
    top_p: float = 0.95,
    top_k: int = 20,
    return_full_text: bool = False,
    seed: Optional[int] = None,
    batch_size: int = 1,
    chat_template: bool = True,
    **kwargs: Any,
) -> Runnable:
    """Wrap a loaded HF model as a LangChain-compatible LLM.

    Parameters
    ----------
    model : PreTrainedModel
        A loaded HF causal-LM model.
    tokenizer : PreTrainedTokenizer
        The associated tokenizer.
    max_new_tokens : int
        Maximum tokens to generate.
    temperature : float
        Sampling temperature.
    top_p : float
        Nucleus sampling parameter.
    top_k : int
        Top-k sampling parameter.
    return_full_text : bool
        If ``False`` (default), only the generated continuation is
        returned; if ``True``, the prompt is prepended to the output.
    seed : int | None
        If provided, all RNG sources (Python random, NumPy, PyTorch CPU
        and CUDA) are seeded before the pipeline is created, making the
        entire generation sequence within a run fully reproducible.
        Pass ``None`` (default) to keep stochastic behaviour.
    batch_size : int
        Number of sequences processed per forward pass (default ``1``).
        Must stay at 1 for all experiments so that latency, throughput,
        and GPU-utilization metrics remain attributable to individual
        problems and both MAS and baseline are measured under identical
        hardware load. Only raise this for a dedicated sustained-
        throughput ceiling experiment, never for the main comparison.
    chat_template : bool
        If ``True`` (default), each prompt is encoded with the model's instruct
        chat template (``tokenize=True``) and run through ``model.generate``
        directly — the HF text-generation pipeline is bypassed. Instruct models
        expect this; without it, weaker models (e.g. Ministral-3-3B) frequently
        emit an immediate EOS and return empty outputs. Tokenizers without a
        chat template fall back transparently to raw tokenisation.

    Returns
    -------
    Runnable
        A LangChain Runnable. With ``chat_template=True`` this is a
        ``RunnableLambda`` that tokenises with the instruct template, calls
        ``model.generate``, and decodes manually. With ``chat_template=False``
        it is a ``HuggingFacePipeline`` fed the raw prompt.
    """
    if seed is not None:
        _seed_all(seed)

    if not chat_template:
        pipe = hf_pipeline(
            "text-generation",
            model=model,
            tokenizer=tokenizer,
            max_new_tokens=max_new_tokens,
            temperature=temperature,
            top_p=top_p,
            top_k=top_k,
            return_full_text=return_full_text,
            do_sample=temperature > 0,
            batch_size=batch_size,
            **kwargs,
        )
        return HuggingFacePipeline(pipeline=pipe)

    # Instruct path: tokenise WITH the chat template (tokenize=True) and call
    # model.generate directly, then decode manually. We deliberately avoid the
    # HF pipeline and any string round-trip: the pipeline applies no chat
    # template to a plain string, and apply_chat_template(tokenize=False) ->
    # re-tokenise does not reliably round-trip the instruct control tokens, so
    # the model never sees the instruct format and emits an immediate EOS
    # (empty output — up to ~50% of samples on the 3B). tokenize=True feeds the
    # exact instruct token ids straight to generate.
    #
    # NOTE: correct *decoding* is the tokenizer's job, not this path's — see
    # load_model_and_tokenizer, which loads Ministral via the mistral-common
    # backend so tokenizer.decode() yields clean text. The LlamaTokenizer that
    # AutoTokenizer would otherwise pick garbles spaces / emits Ġ markers.

    gen_kwargs: dict[str, Any] = {
        "max_new_tokens": max_new_tokens,
        "do_sample": temperature > 0,
    }
    if temperature > 0:
        gen_kwargs.update(temperature=temperature, top_p=top_p, top_k=top_k)
    gen_kwargs.update(kwargs)
    if getattr(tokenizer, "pad_token_id", None) is not None:
        gen_kwargs.setdefault("pad_token_id", tokenizer.pad_token_id)

    def _generate(prompt: Any) -> str:
        # The upstream PromptTemplate yields a StringPromptValue, not a str.
        text = prompt.to_string() if hasattr(prompt, "to_string") else str(prompt)

        # Encode with the instruct template; fall back to raw tokenisation for
        # tokenizers (e.g. base models) that have no chat template.
        try:
            enc = tokenizer.apply_chat_template(
                [{"role": "user", "content": text}],
                add_generation_prompt=True,
                tokenize=True,
                return_tensors="pt",
                return_dict=True,
            )
        except Exception:
            enc = tokenizer(text, return_tensors="pt")

        # Pass input_ids/attention_mask as kwargs — a bare positional tensor
        # mis-routes through the multimodal model's VLM input path.
        enc = {k: v.to(model.device) for k, v in enc.items()}
        input_len = enc["input_ids"].shape[1]

        with torch.inference_mode():
            generated = model.generate(**enc, **gen_kwargs)

        new_tokens = generated[0][input_len:]
        completion = tokenizer.decode(new_tokens, skip_special_tokens=True)
        return text + completion if return_full_text else completion

    return RunnableLambda(_generate)
